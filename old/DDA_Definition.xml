      <Param name="torque_slow" bitsize="8" interval="0.05" canid="25" unit="%"/>
      <Param name="gps_alt" bitsize="16" interval="0.10" canid="1553" operator="mul" value="0.1" unit="m"/>
      <Param name="gps_lon" bitsize="32" interval="0.10" canid="1552" operator="mul" value="0.000001" signed="true" unit="deg"/>
      <Param name="gps_lat" bitsize="32" interval="0.10" canid="1552" operator="mul" value="0.000001" signed="true" unit="deg"/>
      <Param name="lap" bitsize="8" interval="1.00" canid="1553" unit="sec"/>
      <Param name="int_lap1" bitsize="8" interval="1.00" canid="1553" unit="sec"/>
      <Param name="int_lap2" bitsize="8" interval="1.00" canid="1553" unit="sec"/>
    </EntryToRead>
